# Keitaro Admin API
KEITARO_URL=https://your-tracker.example.com
KEITARO_API_KEY=
KEITARO_TIMEOUT=15

# Defaults for created campaigns (IDs from your tracker)
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# Every test campaign name starts with this prefix
CAMPAIGN_PREFIX=test_yourlastname_
FALLBACK_REDIRECT_URL=https://google.com

# "View in KT" link. {id} = campaign id, {base} = KEITARO_URL (without trailing slash).
# Default if not set: {base}/admin/#!/campaign/{id}/main  (set to empty "" to hide the button)
# Example with an explicit host (commented out on purpose: an uncommented copy would override the default):
# KEITARO_CAMPAIGN_URL_TEMPLATE="https://tracker.example/admin/#!/campaign/{id}/main"

# Host header allow-list, comma separated (protection against DNS rebinding)
ALLOWED_HOSTS=127.0.0.1,localhost

# Local DB
DATABASE_URL=sqlite:///./app.db
